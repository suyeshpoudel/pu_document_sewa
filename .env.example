# Copy to .env and fill in your local values:
#   cp .env.example .env
#
# DATABASE_URL format:
#   postgresql://<user>:<password>@<host>:<port>/<db>?schema=public
# URL-encode special chars in the password (? -> %3F, @ -> %40, etc.)

DATABASE_URL="postgresql://suyeshpoudel:YOUR_PASSWORD_HERE@localhost:5432/pu_document_sewa?schema=public"

# Auth (min 32 chars, generate with: openssl rand -base64 32)
JWT_SECRET="change-me-min-32-chars"
JWT_EXPIRES_IN="7d"

# App
FRONTEND_URL="http://localhost:3001"
PORT=3000
