// Prisma schema for PU Document Sewa
// Students apply for PU documents online -> admin verifies -> courier to doorstep

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
  COLLEGE_STAFF
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PAID
  PRINTING
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum PaymentProvider {
  ESEWA
  KHALTI
  BANK_VOUCHER
}

enum PaymentStatus {
  PENDING
  VERIFIED
  FAILED
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  password     String
  name         String
  phone        String?
  role         Role     @default(STUDENT)
  collegeId    Int?
  college      College? @relation(fields: [collegeId], references: [id])
  symbolNo     String?
  regNo        String?
  citizenshipNo String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  applications Application[]
}

model College {
  id           Int      @id @default(autoincrement())
  name         String
  code         String   @unique
  district     String
  address      String?
  contactEmail String?
  contactPhone String?
  createdAt    DateTime @default(now())

  users        User[]
  applications Application[]
}

model DocumentType {
  id             Int      @id @default(autoincrement())
  name           String   @unique
  slug           String   @unique
  feeRs          Int
  description    String?
  requiredDocs   Json     @default("[]")
  processingDays Int      @default(7)
  isActive       Boolean  @default(true)

  applications Application[]
}

model Application {
  id             Int               @id @default(autoincrement())
  studentId      Int
  student        User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  collegeId      Int?
  college        College?          @relation(fields: [collegeId], references: [id])
  documentTypeId Int
  documentType   DocumentType      @relation(fields: [documentTypeId], references: [id])

  fullName   String
  symbolNo   String
  regNo      String
  program    String
  passedYear Int?
  copies     Int     @default(1)

  // Delivery address (doorstep)
  phone              String
  deliveryProvince   String
  deliveryDistrict   String
  deliveryMunicipality String
  deliveryWard       Int?
  deliveryStreet     String?
  deliveryNotes      String?

  status      ApplicationStatus @default(SUBMITTED)
  adminRemark String?
  trackingNo  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files     ApplicationFile[]
  payments  Payment[]
  shipment  Shipment?

  @@index([studentId, status])
  @@index([status])
}

model ApplicationFile {
  id            Int         @id @default(autoincrement())
  applicationId Int
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fileType      String // CITIZENSHIP, MARKSHEET, PHOTO, VOUCHER, OTHER
  fileUrl       String
  createdAt     DateTime    @default(now())

  @@index([applicationId])
}

model Payment {
  id            Int             @id @default(autoincrement())
  applicationId Int
  application   Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  provider      PaymentProvider
  amountRs      Int
  txnId         String?         @unique
  status        PaymentStatus   @default(PENDING)
  rawPayload    Json?
  createdAt     DateTime        @default(now())

  @@index([applicationId])
}

model Shipment {
  id            Int         @id @default(autoincrement())
  applicationId Int         @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  courier       String      @default("MANUAL")
  trackingId    String?
  status        String      @default("PENDING")
  events        Json?       @default("[]")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}
